# Copy to .env.admin when you want to enable the optional admin services.
#
# Used by the Telegram bot:
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_REPORT_CHAT_ID=
TELEGRAM_REPORT_POLL_MS=20000

# Used by mongo-express when you run:
# docker compose --profile admin up -d mongo-express
ME_CONFIG_BASICAUTH_USERNAME=owner
ME_CONFIG_BASICAUTH_PASSWORD=change-this-password
